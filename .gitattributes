# Standard text file handling
*.cpp text diff=cpp
*.h text diff=cpp
*.cs text diff=csharp
*.py text diff=python
*.json text
*.ini text
*.md text
*.txt text
.gitignore text
.gitattributes text

# Unreal Engine Binary Assets
